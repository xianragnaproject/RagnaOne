{
  "install": "bash ./scripts/setup-openkore.sh",
  "start": "bash ./scripts/start-phase12-fleet.sh\nbash /home/ubuntu/openkore/scripts/week-keepalive.sh",
  "ports": [
    {
      "name": "fleet-panel",
      "port": 8787
    }
  ],
  "terminals": [
    {
      "name": "week-keepalive",
